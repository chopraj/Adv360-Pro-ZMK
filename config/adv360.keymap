#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        tmuxmax: tmuxmax {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp Z>;
            label = "TMUXMAX";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            display-name = "Base";
            bindings = <
&kp ESCAPE     &kp N1            &kp N2        &kp N3    &kp N4     &kp N5  &none                                                                                              &none              &kp N6  &kp N7        &kp N8     &kp N9    &kp N0    &kp GRAVE
&kp TAB        &kp Q             &kp W         &kp E     &kp R      &kp T   &none                                                                                              &none              &kp Y   &kp U         &kp I      &kp O     &kp P     &kp BACKSPACE
&kp LEFT_ALT   &kp A             &kp S         &kp D     &kp F      &kp G   &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LC(C)        &kp C_VOLUME_UP    &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp H   &kp J         &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT      &kp Z             &kp X         &kp C     &kp V      &kp B                                           &kp AT_SIGN      &kp C_VOLUME_DOWN                                            &kp N   &kp M         &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LG(SLASH)  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT  &kp RIGHT          &kp ENTER         &kp LCMD              &kp LC(B)        &tmuxmax           &mo 1                  &kp SPACE                  &kp UP_ARROW  &kp DOWN   &kp LBKT  &kp RBKT  &mo 0
            >;
        };

        Layer2 {
            display-name = "Base";
            bindings = <
&kp ESCAPE    &kp N1             &kp N2           &kp N3     &kp N4     &kp N5         &none                                                            &none              &kp N6          &kp N7          &kp N8        &kp N9           &kp N0    &kp GRAVE
&kp TAB       &kp Q              &kp W            &kp EQUAL  &kp R      &kp STAR       &none                                                            &none              &kp Y           &kp U           &kp I         &kp PIPE         &kp PLUS  &kp BSLH
&kp LEFT_ALT  &kp AMPERSAND      &kp MINUS        &kp SLASH  &kp F      &kp G          &kp LEFT_BRACKET  &none     &none      &bl BL_CYCLE  &bl BL_TOG  &kt RIGHT_BRACKET  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp SEMI  &kp SQT
&kp LSHFT     &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &kp C      &kp V      &kp BACKSLASH                              &none      &none                                        &kp N           &kp M           &kp COMMA     &kp DOT          &kp FSLH  &kp RSHFT
&mo 0         &kp GRAVE          &kp CAPS         &kp LEFT   &kp RIGHT                 &kp ENTER         &kp LCMD  &none      &none         &kp SPACE   &kp SPACE                          &kp BACKSPACE   &kp DOWN      &kp LBKT         &kp RBKT  &mo 0
            >;
        };
    };
};
